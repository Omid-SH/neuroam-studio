# local Python environment -- never portable, never committed
.venv/

# stray backup archive (superseded by tracked source) -- keep local only
neuroam-am-viz-update.tar.gz

# the 6 full-head RatCC montage sets: 619-823 MB each, over GitHub's 100 MB
# hard per-file limit -- regenerate via the lab mesher / examples/28, or
# fetch separately; only these large binaries are excluded, not the rest
# of samples/ (small .in configs, electrode designs, neuron models, the
# small crop models, and verification outputs all stay tracked)
samples/ratcc_eye_83um/*_912_900_504_*.model
samples/ratcc_eye_83um/*_912_900_504_*.mrm
samples/ratcc_eye_83um/*_912_900_504_*.vof

# same reason, same full-head grid -- examples/38's per-config solve outputs
# (~620-650 MB each, one per clinical config): regenerate via
# examples/38_solve_clinical_configs.py <config_key>
samples/ratcc_eye_83um/clinical_*.vof

# interactive plotly electrode views (examples/42) -- each embeds raw
# marching-cubes mesh data as uncompressed JSON text (up to ~90 MB/file,
# ~600 MB total across the 15 configs) with no bound on how large a future
# re-render grows; regenerate locally via
# examples/42_electrode_3d_placement.py instead of committing them
samples/ratcc_eye_83um/verification/views/electrode_3d/
samples/ratcc_eye_83um/verification/views/electrode_placement_3d_grid.html
